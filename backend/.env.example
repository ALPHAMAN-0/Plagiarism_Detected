# =============================================================================
# Plagiarism_Detected Backend — environment example
# Copy to .env and fill in. No secrets should ever be committed.
# =============================================================================

# API
APP_NAME=Plagiarism_Detected
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# CORS: comma-separated list of allowed origins. DO NOT use "*" in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Storage
UPLOADS_DIR=./data/uploads
INDEXES_DIR=./data/indexes
DB_URL=sqlite+aiosqlite:///./data/plagiarism.db

# File upload limits
MAX_UPLOAD_BYTES=10485760           # 10 MB
ALLOWED_MIME_PREFIXES=application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document
ALLOWED_EXTENSIONS=pdf,txt,docx

# Auth (optional). If unset, anonymous mode is allowed in dev only.
# API_KEY=replace-me-with-a-long-random-string

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
UPLOAD_RATE_LIMIT_PER_HOUR=10

# Model paths (project-controlled, never accept user input here)
ML_MODELS_DIR=./app/ml_models
AI_CLASSIFIER_PATH=./app/ml_models/ai_classifier.joblib
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
PERPLEXITY_MODEL_NAME=distilgpt2

# Algorithm defaults
DEFAULT_NGRAM_SIZE=5
DEFAULT_TOP_K_MATCHES=5
DEFAULT_SIMILARITY_THRESHOLD=0.6
